{
  "name": "mez/queuejitsu",
  "description": "A Modern Queueing System",
  "license": "MIT",
  "type": "library",
  "authors": [
    {
      "name": "Martin Meredith",
      "email": "martin@sourceguru.net"
    }
  ],
  "require": {
    "php": "^8.2",
    "ext-json": "*",
    "ext-pcntl": "*",
    "ext-posix": "*",
    "laminas/laminas-eventmanager": "^3.13",
    "predis/predis": "^3.3",
    "psr/container": "^1.1 || ^2.0",
    "psr/log": "^1.1 || ^2.0 || ^3.0",
    "ramsey/uuid": "^4.7"
  },
  "require-dev": {
    "ergebnis/composer-normalize": "^2.45",
    "friendsofphp/php-cs-fixer": "^3.64",
    "maglnet/composer-require-checker": "^4.7",
    "phpstan/phpstan": "^2.1"
  },
  "conflict": {
    "psr/http-message": "<1.1"
  },
  "suggest": {
    "ext-pcntl": "Allows Workers to be ran in forked processes",
    "mez/queuejitsu-cli": "Command Line integration",
    "predis/predis": "Connect up to Redis"
  },
  "autoload": {
    "psr-4": {
      "QueueJitsu\\": "src"
    }
  },
  "config": {
    "allow-plugins": {
      "ergebnis/composer-normalize": true
    },
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "extra": {
    "laminas": {
      "config-provider": "QueueJitsu\\ConfigProvider"
    }
  },
  "scripts": {
    "check": [
      "@composer validate --strict",
      "@normalize-check",
      "@cs-check",
      "@phpstan",
      "@require-check"
    ],
    "cs-check": "php-cs-fixer check --diff --verbose",
    "cs-fix": "php-cs-fixer fix --verbose",
    "normalize-check": "@composer normalize --dry-run --indent-size=2 --indent-style=space",
    "phpstan": "phpstan analyse",
    "require-check": "composer-require-checker check composer.json"
  }
}
